// @name: FTP-Backup
// todo: use @name as identifier for all log messages instead of string "ftp-bkp" via compiler enhancement https://github.com/gemu2015/Sonoff-Tasmota/issues/137
// @info: https://ottelo9.github.io/tasmota-sml-script/sml/#ftp
// @order: 31
// ftp_backup.tc — copies the data and configuration of TinyC and programs to an FTP server
// (FRITZ!NAS, Synology, ...) every night at 00:10 and on press of the Backup button.
// Runs in its own slot next to the SML program, so devices without activated backup don't consume RAM! 
//
// Docs: https://ottelo9.github.io/tasmota-sml-script/sml/#ftp
//
// Sends every *.pvs, *.cfg and *.def from the file system to
// /ftp-user-home-directory/<cfg:dir>/<host name>/<1..7>/ (weekday of the run, Monday = 1), so a week
// of copies is kept; the manual Backup button uses folder 0 instead.
//
// /ftp.cfg: with the KEY values:
// HOST=, USER=, PW=, DIR=, // comments
// each KEY= must be starting on a line of its own!
// Without HOST= the script fails with error -11.

char sml_vers[] = "25.10.2026 20:55";  // build.html: version in the .tcb header and index.json
// todo: convert to @version   https://github.com/gemu2015/Sonoff-Tasmota/issues/138

persist int bk_res;            // 0 never, 1 ok, 2 failed
persist int bk_code;           // last error
persist int bk_d;              // last backup day
persist int bk_m;              // last backup month 
persist int bk_y;              // last backup year
persist int bk_hm;             // hhmm
int bk_go;                     // Backup button
int bk_now;                    // start at the next tick
int bk_busy;                   // worker running
int bk_day;                    // day of the last nightly run
int bk_man;                    // 1 = started by the button
int bk_ack;                    // seconds the button still shows the result

// Value of "KEY=" at a line start, up to the line end, spaces trimmed.
// pos = strFind of the key; anywhere else than at line start is invalid!
void GetKeyValue(byte d[], byte s[], int pos, int max) {
    d[0] = 0;
    if (pos < 0) return;
    if (pos > 0 && s[pos - 1] != '\n') return;
    while (s[pos] != '=') pos = pos + 1;
    pos = pos + 1;
    while (s[pos] == ' ') pos = pos + 1;
    int i = 0;
    while (s[pos] != 0 && s[pos] != '\n' && s[pos] != '\r' && i < max - 1) {
        d[i] = s[pos];
        i = i + 1;
        pos = pos + 1;
    }
    while (i > 0 && d[i - 1] == ' ') i = i - 1;
    d[i] = 0;
}

int SelectFile(byte n[]) {
// exclude files
//    if (strcmp(n, "ftp_backup.pvs") == 0) return 0;
//    if (strcmp(n, "tinyc.cfg") == 0) return 0;
// include files
// todo: select only trailing file extension, currently each file with partial match would be selected!!
    if (strFind(n, ".pvs") > 0) return 1;
    if (strFind(n, ".def") > 0) return 1;
    if (strFind(n, ".cfg") > 0) return 1;
// ignore all other files
    return 0;
}

// spawnTask worker: FTP blocks, and here the VM lets go meanwhile. Its own
// VM needs the firmware fix that lets a worker use arrays > 16 elements
// (tasmota-sml-images, 12.10.2026) - without it this dies with BOUNDS.
// todo: check image version on init
//  add error check instead of void!

void ftp-bkpWorker() {
    byte cfg[512]; 
    byte host[40]; 
    byte user[40]; 
    byte pw[40]; 
    byte dir[128];
// todo: self documenting names
    byte t[40]; byte n[48]; byte l[52]; byte r[180];
    int err = -11;
    int cnt = 0;
    int f = fileOpen("/ftp.cfg", 0);
    if (f >= 0) {
        int k = fileRead(f, cfg, 511);
        fileClose(f);
        if (k < 0) k = 0;
        cfg[k] = 0;
        GetKeyValue(host, cfg, strFind(cfg, "HOST="), 40);
        GetKeyValue(user, cfg, strFind(cfg, "USER="), 40);
        GetKeyValue(pw, cfg, strFind(cfg, "PW="), 40);
        GetKeyValue(dir, cfg, strFind(cfg, "DIR="), 100);

// todo: validate host but don't try to be smarter than user, instead fail if unexpected things have been provided by user!
        int q = strFind(host, "://");           // "ftp://ip" or "http://ip/" written by mistake
        if (q >= 0) {
            strSub(t, host, q + 3, 39);   // todo: explain purpose!
            strcpy(host, t);
        }
        q = strlen(host) - 1;
        if (q > 0 && host[q] == '/') host[q] = 0;  // todo: explain purpose!
        q = strlen(dir) - 1;
        if (q > 0 && dir[q] == '/') dir[q] = 0;    // todo: explain purpose!
    }
    if (host[0] == 0) f = -1;                   // no HOST=: as if there were no file

// todo: use tasmota/tinyc/examples/common/nas_backup.tc where possible! 
    if (f >= 0) {
//  Note: old version used "tasmInfo(0, t);" // 0 = MQTT topic
        tasmInfo(4, t); // 4 =  device_name = host name of ESP
        err = ftpOpen(host, user, pw);
        if (err == 0) {
            addLog("ftp-bkp: ftpMkdir dir: %s", dir);
            void ftpMkdir(dir);                 // refused if it exists - fine
            strcat(dir, "/");
            strcat(dir, t);
            addLog("ftp-bkp: ftpMkdir dir: %s", dir);
            ftpMkdir(dir);
            int wd = os_dayOfWeek - 1;      // Tasmota: 1 = Sunday
            if (wd < 1) wd = 7;
            if (bk_man == 1) wd = 0;
            sprintf(n, "/%d", wd);
            strcat(dir, n);
            addLog("ftp-bkp: ftpMkdir dir: %s", dir);
            ftpMkdir(dir);
            int dh = fileOpenDir("/");
            if (dh >= 0) {
                while (err >= 0 && fileReadDir(dh, n)) {
                    if (SelectFile(n)) {
                        sprintf(l, "/%s", n);
                        sprintf(r, "%s/%s", dir, n);
                        addLog("ftp-bkp: ftpPut dir: %s", r);
                        err = ftpPut(r, l, 0);
                        if (err >= 0) cnt = cnt + 1;
                    }
                }
                fileClose(dh);
            }
            ftpClose();
        }
    }
    bk_d = os_day; bk_m = os_month; bk_y = os_year;
    bk_hm = os_hour * 100 + os_minute;
    if (err >= 0) {
        bk_res = 1;
        addLog("ftp-bkp: %d files", cnt);
    } else {
        bk_res = 2;
        bk_code = err;
        addLog("ftp-bkp: error %d", err);
    }
    if (bk_man == 1) bk_ack = 5;
    bk_busy = 0;
}

void EverySecond() {
    if (bk_ack > 0) bk_ack = bk_ack - 1;
    if (bk_busy) {
        // The worker ends with bk_busy = 0. Gone without it = it crashed.
        if (taskRunning("ftp-bkpWorker") == 0) {
            bk_busy = 0;
            bk_res = 2;
            bk_code = -13;
            bk_d = os_day; bk_m = os_month; bk_y = os_year;
            bk_hm = os_hour * 100 + os_minute;
            if (bk_man == 1) bk_ack = 5;
        }
        return;
    }
    // 00:10: the SML programs write their files at midnight.
    if (os_hour == 0 && os_minute == 10 && bk_day != os_day && os_year > 2020) {
        bk_day = os_day;
        bk_now = 1;
        bk_man = 0;
    }
    if (bk_now == 0) return;
    bk_now = 0;
    bk_busy = 1;
    if (spawnTask("ftp-bkpWorker", 8) < 0) {
        bk_busy = 0;
        bk_res = 2;
        bk_code = -12;
    }
}

void WebCall() {
    byte b[24];
    // Handled while drawing: left to the next tick, the answer would still
    // show the button pressed and the next click would send 0.
    if (bk_go == 1) {
        bk_go = 0;
        if (bk_busy == 0) { bk_now = 1; bk_man = 1; }
    }
    if (bk_busy == 1 || bk_now == 1) strcpy(b, "#fa0");
    else if (bk_res == 1)            strcpy(b, "#0c0");
    else if (bk_res == 2)            strcpy(b, "#e00");
    else                             strcpy(b, "#888");
    byte c[260];
    if (bk_res == 0) {
        sprintf(c, "{s}<span style='color:%s'>&#9679;</span> -", b);
    } else {
        sprintf(c, "{s}<span style='color:%s'>&#9679;</span> <span style='font-weight:normal;font-size:.85em'>&#x1F552; %02d.%02d.%04d - %02d:%02d</span>", b, bk_d, bk_m, bk_y, bk_hm / 100, bk_hm % 100);
    }
    if (bk_res == 2) {
        sprintf(b, " (%d)", bk_code);
        strcat(c, b);
    }
    strcat(c, "{m}<a href='/ufse?file=/ftp.cfg'>ftp.cfg</a>{e}");
    webSend(c);
    // The click itself only flashes a tick; the label shows the run and its
    // result for a few seconds, so a press is visible.
    byte lb[24];
    if (bk_busy == 1 || bk_now == 1)  strcpy(lb, "&#x23F3; Backup");
    else if (bk_ack > 0 && bk_res == 1) strcpy(lb, "&#x2705; Backup");
    else if (bk_ack > 0)              strcpy(lb, "&#x274C; Backup");
    else                              strcpy(lb, "Backup");
    webButtonV(bk_go, lb);
}

int main() {
    addLog("ftp-bkp: start %s", sml_vers);
    return 0;
}
